<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzuli.agricultural.mapper.ProductOrderMapper">
    <insert id="insertProductOrder" parameterType="com.zzuli.agricultural.model.ProductOrder">
        INSERT INTO ProductOrders (product_id, quantity, total_price, price, seller_user_id, buyer_user_id, purchase_time, payment_status, is_valid)
        VALUES (#{productId}, #{quantity}, #{totalPrice}, #{price}, #{sellerUserId}, #{buyerUserId}, #{purchaseTime}, #{paymentStatus}, #{isValid})
    </insert>

    <delete id="deleteProductOrder" parameterType="int">
        DELETE FROM ProductOrders WHERE id = #{id}
    </delete>

    <update id="updateProductOrder" parameterType="com.zzuli.agricultural.model.ProductOrder">
        UPDATE ProductOrders
        SET product_id = #{productId},
            quantity = #{quantity},
            total_price = #{totalPrice},
            price = #{price},
            seller_user_id = #{sellerUserId},
            buyer_user_id = #{buyerUserId},
            purchase_time = #{purchaseTime},
            payment_status = #{paymentStatus},
            is_valid = #{isValid}
        WHERE id = #{id}
    </update>

    <select id="selectProductOrder" parameterType="int" resultType="com.zzuli.agricultural.model.ProductOrder">
        SELECT * FROM ProductOrders WHERE id = #{id}
    </select>

    <select id="selectAllProductOrders" resultType="com.zzuli.agricultural.model.ProductOrder">
        SELECT <include refid="BaseSelect"/> FROM ProductOrders
    </select>

    <resultMap id="BaseResultMap" type="com.zzuli.agricultural.model.ProductOrder">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <id column="product_id" jdbcType="INTEGER" property="productId"/>
        <result column="total_price" jdbcType="DOUBLE" property="totalPrice"/>
        <result column="quantity" jdbcType="INTEGER" property="quantity"/>
        <result column="price" jdbcType="DOUBLE" property="price"/>
        <result column="seller_user_id" jdbcType="INTEGER" property="sellerUserId"/>
        <result column="buyer_user_id" jdbcType="INTEGER" property="buyerUserId"/>
        <result column="purchase_time" jdbcType="INTEGER" property="purchaseTime"/>
        <result column="payment_status" jdbcType="INTEGER" property="paymentStatus"/>
        <result column="is_valid" jdbcType="INTEGER" property="isValid"/>
    </resultMap>

    <sql id="BaseSelect">
        id, product_id, quantity, total_price, price, seller_user_id, buyer_user_id, purchase_time, payment_status, is_valid
    </sql>

    <!-- 根据参数查询用户信息 -->
    <select id="selectByParams" resultMap="BaseResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="BaseSelect"/>
        FROM ProductOrders
        <where>
            <if test="sellerUserId != null">AND `seller_user_id` = #{sellerUserId}</if>
            <if test="buyerUserId != null">AND `buyer_user_id` = #{buyerUserId}</if>
            <if test="productId != null">AND `product_id` = #{productId}</if>
        </where>
        <if test="start != null and pageSize != null">
            LIMIT #{start}, #{pageSize}
        </if>
    </select>

</mapper>