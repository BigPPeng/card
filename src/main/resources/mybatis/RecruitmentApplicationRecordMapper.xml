<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzuli.agricultural.mapper.RecruitmentApplicationRecordMapper">

    <!-- ResultMap to map the SQL result to the RecruitmentApplicationRecord model -->
    <resultMap id="RecruitmentApplicationRecordResultMap" type="com.zzuli.agricultural.model.RecruitmentApplicationRecord">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="recruitment_info_id" property="recruitmentInfoId" jdbcType="INTEGER"/>
        <result column="applicant_id" property="applicantId" jdbcType="INTEGER"/>
        <result column="applicant_name" property="applicantName" jdbcType="VARCHAR"/>
        <result column="application_time" property="applicationTime" jdbcType="INTEGER"/>
    </resultMap>

    <!-- SQL statement to insert a new RecruitmentApplicationRecord record -->
    <insert id="insertRecruitmentApplicationRecord" parameterType="com.zzuli.agricultural.model.RecruitmentApplicationRecord">
        INSERT INTO RecruitmentApplicationRecords (recruitment_info_id, applicant_id, applicant_name, application_time)
        VALUES (#{recruitmentInfoId}, #{applicantId}, #{applicantName}, #{applicationTime})
    </insert>

    <!-- SQL statement to update an existing RecruitmentApplicationRecord record -->
    <update id="updateRecruitmentApplicationRecord" parameterType="com.zzuli.agricultural.model.RecruitmentApplicationRecord">
        UPDATE RecruitmentApplicationRecords
        SET recruitment_info_id = #{recruitmentInfoId},
            applicant_id = #{applicantId},
            applicant_name = #{applicantName},
            application_time = #{applicationTime}
        WHERE id = #{id}
    </update>

    <!-- SQL statement to select a single RecruitmentApplicationRecord record by id -->
    <select id="selectRecruitmentApplicationRecordById" parameterType="int" resultMap="RecruitmentApplicationRecordResultMap">
        SELECT * FROM RecruitmentApplicationRecords WHERE id = #{id}
    </select>

    <!-- SQL statement to select all RecruitmentApplicationRecord records -->
    <select id="selectAllRecruitmentApplicationRecords" resultMap="RecruitmentApplicationRecordResultMap">
        SELECT * FROM RecruitmentApplicationRecords
    </select>

    <!-- SQL statement to delete an RecruitmentApplicationRecord record by id -->
    <delete id="deleteRecruitmentApplicationRecord" parameterType="int">
        DELETE FROM RecruitmentApplicationRecords WHERE id = #{id}
    </delete>


    <sql id="BaseSelect">
        id, recruitment_info_id, applicant_id, applicant_name, application_time
    </sql>

    <select id="selectByParams" resultMap="RecruitmentApplicationRecordResultMap" parameterType="java.util.Map">
        SELECT
        <include refid="BaseSelect"/>
        FROM RecruitmentApplicationRecords
        <where>
            <if test="recruitmentInfoId != null">AND `recruitment_info_id` = #{recruitmentInfoId}</if>
            <if test="applicantId != null">AND `applicant_id` = #{applicantId}</if>
            <if test="applicantName != null">AND `applicant_name` = #{applicantName}</if>
        </where>
        <if test="start != null and pageSize != null">
            LIMIT #{start}, #{pageSize}
        </if>
    </select>

</mapper>